#!/usr/bin/env bash
# SUPER DESKTOP - Native Rust / Python launcher
set -e

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"

# Ensure GTK4 Layer Shell library is preloaded
LAYER_SHELL_LIB="/usr/lib/libgtk4-layer-shell.so"
if [[ -f "$LAYER_SHELL_LIB" ]]; then
    if [[ ":$LD_PRELOAD:" != *":$LAYER_SHELL_LIB:"* ]]; then
        export LD_PRELOAD="$LAYER_SHELL_LIB${LD_PRELOAD:+:$LD_PRELOAD}"
    fi
fi

# Prefer high-performance compiled Rust native binary (685KB, 240Hz frame-tick dragging)
RUST_BIN="$SCRIPT_DIR/target/release/super-desktop"
if [[ -x "$RUST_BIN" ]]; then
    exec "$RUST_BIN" "$@"
fi

# Fallback to Python module
export PYTHONPATH="$SCRIPT_DIR:$PYTHONPATH"
exec python3 -m super_desktop.main "$@"
