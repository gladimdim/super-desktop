        {
          "name": "title",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 80
          }
        },
        {
          "name": "body",
          "required": false,
          "schema": {
            "type": "string",
            "maxLength": 400
          }
        },
        {
          "name": "urgency",
          "required": false,
          "schema": {
            "enum": [
              "low",
              "normal",
              "critical"
            ]
          }
        }
      ],
      "result": {
        "name": "ok",
        "schema": {
          "type": "object"
        }
      }
    },
