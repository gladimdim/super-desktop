        }
      ],
      "result": {
        "name": "ok",
        "schema": {
          "type": "object"
        }
      }
    },
    {
      "name": "harness.launch",
      "tags": [
        {
          "name": "host"
        }
      ],
      "x-permission": "harness.launch",
      "summary": "Open a new, visible card running a harness in an existing folder. agent is a built-in key (claude, codex, opencode, gemini, ...) or a custom launcher key. With prompt, the harness starts working on it at once (passed once on its command line; claude, codex, grok, cursor, opencode, gemini and antigravity only, others answer unavailable). The prompt is never saved with the card and is not shown to other devices.",
      "params": [
        {
          "name": "agent",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "folder",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "prompt",
          "required": false,
          "schema": {
            "type": "string",
            "maxLength": 16384
          }
        }
      ],
      "result": {
        "name": "card",
        "schema": {
          "type": "object",
          "properties": {
            "card": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "name": "harness.writeConfig",
      "tags": [
        {
          "name": "host"
        }
      ],
      "x-permission": "harness.provide",
      "summary": "Write a configuration file a plugin harness needs (for example a hook file under ~/.acme). Journaled: deactivation restores the previous content or removes the file. The path must be under $HOME and outside ~/.config/super-desktop and ~/.config/hypr.",
      "params": [
        {
          "name": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "content",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 262144
          }
        }
      ],
      "result": {
        "name": "ok",
        "schema": {
          "type": "object"
        }
      }
    },
    {
      "name": "llm.complete",
      "tags": [
        {
          "name": "host"
        }
      ],
      "x-permission": "llm",
      "summary": "One completion from the AI provider the user chose in Settings -> Plugins -> AI provider (a signed-in harness CLI, or an API key). The plugin never sees credentials. Prompt at most 64 KiB; at most 2 calls at a time; 120 s timeout. With json:true the text is a JSON document.",
      "params": [
        {
          "name": "prompt",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 65536
          }
        },
        {
          "name": "system",
          "required": false,
          "schema": {
            "type": "string",
            "maxLength": 16384
          }
        },
        {
          "name": "maxTokens",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192,
            "default": 1024
          }
        },
        {
          "name": "json",
          "required": false,
          "schema": {
            "type": "boolean",
            "default": false
          }
        },
        {
          "name": "tier",
          "required": false,
          "schema": {
            "enum": [
              "default",
              "fast"
            ],
            "default": "default"
          }
        }
      ],
      "result": {
        "name": "completion",
        "schema": {
          "type": "object",
          "required": [
            "text",
            "provider",
            "model"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "name": "title.set",
      "tags": [
        {
          "name": "host"
        }
      ],
      "x-permission": "ui.titles",
      "summary": "Set what this PC draws as a card's title. Display only: never stored as the prompt and never sent to the phone or other PCs. Omitted fields keep their previous value; null clears one.",
      "params": [
        {
          "name": "card",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "text",
          "required": false,
          "schema": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          }
        },
        {
          "name": "chipsBefore",
          "required": false,
          "schema": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/Chip"
            }
          }
        },
        {
          "name": "chipsAfter",
          "required": false,
          "schema": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/Chip"
            }
          }
        }
      ],
      "result": {
        "name": "ok",
        "schema": {
          "type": "object"
        }
      }
    },
    {
      "name": "title.clear",
      "tags": [
        {
          "name": "host"
        }
      ],
      "x-permission": "ui.titles",
      "params": [
        {
          "name": "card",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "ok",
        "schema": {
          "type": "object"
        }
      }
    }
  ],
  "components": {
    "schemas": {
      "Status": {
        "enum": [
          "working",
          "completed",
          "idle",
          "waiting",
          "error",
          "unknown"
        ]
      },
      "Point": {
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      },
      "Rect": {
        "type": "object",
        "required": [
          "x",
          "y",
          "w",
          "h"
        ],
        "description": "Logical pixels in the overlay canvas; (0,0) is the top-left of the screen.",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          }
        }
      },
      "Screen": {
        "type": "object",
        "required": [
          "w",
          "h",
          "top"
        ],
        "properties": {
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          },
          "top": {
            "type": "number",
            "description": "Bottom edge of the top bar; cards live below it."
          }
        }
      },
      "CardInfo": {
        "type": "object",
        "required": [
          "id",
          "session",
          "agent",
          "folder",
          "status",
          "prompt",
          "rect",
          "iconified",
          "expanded",
          "focused",
          "local"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "session": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "folder": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "prompt": {
            "type": [
              "string",
              "null"
            ],
            "description": "The vetted user prompt. Never another plugin's title."
          },
          "rect": {
            "$ref": "#/components/schemas/Rect"
          },
          "icon": {
            "$ref": "#/components/schemas/Point"
          },
          "iconified": {
            "type": "boolean"
          },
          "expanded": {
            "type": "boolean"
          },
          "focused": {
            "type": "boolean"
          },
          "local": {
            "type": "boolean"
          }
        }
      },
      "CommandContext": {
        "type": "object",
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "enum": [
              "shortcut",
              "toolbar",
              "cardButton",
              "cardControl",
              "cli",
              "view"
            ]
          },
          "card": {
            "$ref": "#/components/schemas/CardInfo"
          },
          "args": {
            "description": "JSON given to 'super-desktop plugin run <id> <command> [json]'."
          }
        }
      },
      "Chip": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "tone": {
            "enum": [
              "neutral",
              "accent",
              "success",
              "warning",
              "error"
            ]
          },
          "tooltip": {
            "type": "string",
            "maxLength": 120
          }
        }
      },
      "Theme": {
        "type": "object",
        "properties": {
          "dark": {
            "type": "boolean"
          },
          "accent": {
            "type": "string"
          },
          "background": {
            "type": "string"
          },
          "foreground": {
            "type": "string"
          },
          "font": {
            "type": "string"
          }
        }
      }
    }
  }
}
