{
  "$schema": "https://raw.githubusercontent.com/gladimdim/super-desktop/master/skills/super-desktop-plugin/schemas/manifest.schema.json",
  "manifestVersion": 1,
  "id": "center-magnify",
  "name": "Center Magnify",
  "version": "0.1.0",
  "description": "Cards grow toward 70% of the screen near the centre and become icons docked at the left and right edges.",
  "author": "SUPER DESKTOP examples",
  "license": "MIT",
  "engines": { "superDesktop": ">=1.2.0", "pluginApi": "1" },
  "permissions": ["layout.renderer"],
  "contributes": {
    "renderer": { "id": "center-magnify.renderer", "wasm": "renderer.wasm" }
  }
}
